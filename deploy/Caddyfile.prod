# PRODUKTION — eigene Domain (Let's-Encrypt, Auto-Renewal) + direkter IP-Zugriff.
#
# Hosts kommen aus der Umgebung (systemd-Drop-in caddy.service.d/override.conf),
# damit das Repo host-agnostisch bleibt — KEINE Domain/IP hartkodieren:
#   SITE_HOST=<domain>      z. B. example.de
#   SERVER_IP=<server-ip>   z. B. 203.0.113.10
#
# Die Domain bekommt ein normales LE-Zertifikat (TLS-ALPN/HTTP-01). Der
# IP-Block behält das 6-Tage-"shortlived"-Cert und hält bestehende
# Magic-Links auf https://<ip> am Leben.
{
	# Clients, die per IP zugreifen, senden KEIN SNI (SNI ist für Hostnamen).
	# Ohne das matcht Caddy die Site nicht → TLS "internal error". default_sni
	# behandelt SNI-lose Handshakes als die IP-Site.
	default_sni {$SERVER_IP}
}

# Gemeinsame Site-Konfiguration (Domain + IP teilen sie sich).
(site) {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow, noarchive"

	# Die App lebt unter /portfolio (Next basePath). Nackte Root und alte
	# /unlock-Magic-Links dorthin umleiten — das #code-Fragment hängt der
	# Browser selbst an die Ziel-URL an. Temporär (302), damit nichts im
	# Browser-Cache einrastet, solange die Struktur sich noch setzen kann.
	@root path /
	redir @root /portfolio
	@unlock path /unlock /unlock/
	redir @unlock /portfolio/unlock

	# Nature One Camp — Anmelde-App (FastAPI, systemd --user nature-camp, 127.0.0.1:8090).
	# handle_path strippt das /nature-one-Prefix; die App laeuft intern unter "/".
	handle_path /nature-one* {
		reverse_proxy 127.0.0.1:8090
	}

	# Hevy -> Garmin Sync (FastAPI, systemd --user hevy-garmin-sync, 127.0.0.1:8091).
	handle_path /Hevy2Garmin* {
		reverse_proxy 127.0.0.1:8091
	}

	# Flip 7 — gemeinsamer Live-Punktezaehler (FastAPI, systemd --user
	# flip7-live, 127.0.0.1:8092). handle_path strippt das /Flip7-Prefix;
	# die Oberflaeche setzt es fuer ihre API-Aufrufe selbst wieder davor.
	# Ohne Schrägstrich am Ende wuerden die relativen Verweise der Seite
	# (Manifest, Symbole, Service Worker) eine Ebene zu hoch landen.
	redir /Flip7 /Flip7/ 301

	handle_path /Flip7* {
		reverse_proxy 127.0.0.1:8092
	}

	# WhisperLoom — eigenes F-Droid-Repository (statische Dateien, systemd --user whisperloom-fdroid,
	# 127.0.0.1:8130). handle_path strippt /fdroid; der Index liegt unter /fdroid/repo/.
	handle_path /fdroid* {
		reverse_proxy 127.0.0.1:8130
	}

	# Portfolio (Next.js, 127.0.0.1:3100) — Catch-all fuer alles Uebrige.
	handle {
		reverse_proxy 127.0.0.1:3100
	}
}

# Gemeinsame Basis für Subdomain-Dienste — bewusst OHNE den Portfolio-Catch-all
# aus (site): eine Subdomain gehört genau einem Dienst.
(subsite) {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow, noarchive"
}

# www → apex (dauerhafte Weiterleitung).
www.{$SITE_HOST} {
	redir https://{$SITE_HOST}{uri} permanent
}

# Haupt-Site über die Domain.
{$SITE_HOST} {
	import site
}

# hermes-bridge — nimmt Sprachaufträge von WhisperLoom entgegen und gibt sie an den
# Hermes-Agenten weiter (systemd --user hermes-bridge, 127.0.0.1:8093).
hermes-bridge.{$SITE_HOST} {
	import subsite
	reverse_proxy 127.0.0.1:8093
}

# Fallback: direkter Zugriff per IP (6-Tage-IP-Cert).
https://{$SERVER_IP} {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	import site
}
